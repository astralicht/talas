# Copy to .env.local and fill in local values. Never commit secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=mongodb://localhost:27017/talas?replicaSet=rs0
REDIS_URL=redis://localhost:6379

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters

# Session lifetimes in seconds (constitution v2.0.0: access tokens expire
# within 24 hours, refresh tokens within 30 days; refresh must be >= access).
# Defaults shown; access is bounded to 300..86400, refresh to 3600..2592000.
SESSION_ACCESS_TTL_SECONDS=86400
SESSION_REFRESH_TTL_SECONDS=2592000

OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# openai | google | opengo (opengo = OpenCode Go subscription inference;
# output cap is 8192 tokens (TODO step 17): reasoning models spend hidden
# reasoning from the same budget, so complex figure-rich lessons need the
# doubled cap
# requires OPENCODE_API_KEY below; chat-completions model IDs only, e.g.
# glm-5.3, kimi-k2, deepseek-v3)
AI_PROVIDER=openai
AI_DAILY_BUDGET_USD=2.00
AI_FAULT_INJECTION=false

# OpenCode Go (AI_PROVIDER=opengo). Default model glm-5.3-flash. Found live
# (TODO step 17): it DOES reason on complex, figure-rich input — reasoning
# shares the completion budget, which is why the cap was doubled to 8192
# tokens. Thinking models truncate their JSON when reasoning + output exceed
# the cap; simpler inputs stay well inside it.
OPENCODE_API_KEY=
AI_MODEL_OPENGO=glm-5.3-flash

RESEND_API_KEY=
EMAIL_FROM=Talas <no-reply@talas.local>
MAILHOG_SMTP_URL=smtp://localhost:1025

LOG_LEVEL=debug
# Dev-only ngrok tunnel host, consumed by `scripts/dev-stack.ps1 tunnel` and
# `scripts/dev-stack.sh tunnel`. Empty = random free URL (changes on every
# restart); set to a claimed static domain, e.g. NGROK_DOMAIN=name.ngrok-free.app
NGROK_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
WORKER_CONCURRENCY=2
MAX_JOB_MS=120000
