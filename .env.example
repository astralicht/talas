# Copy to .env.local and fill in local values. Never commit secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=mongodb://localhost:27017/talas?replicaSet=rs0
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=talas-local
S3_ACCESS_KEY_ID=talas
S3_SECRET_ACCESS_KEY=talas-local-secret
S3_FORCE_PATH_STYLE=true

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters

OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PROVIDER=openai
AI_DAILY_BUDGET_USD=2.00
AI_FAULT_INJECTION=false

RESEND_API_KEY=
EMAIL_FROM=Talas <no-reply@talas.local>
MAILHOG_SMTP_URL=smtp://localhost:1025

LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
WORKER_CONCURRENCY=2
MAX_JOB_MS=120000
