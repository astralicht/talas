# Copy to .env.local and fill in local values. Never commit secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=mongodb://localhost:27017/talas?replicaSet=rs0
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=talas-local
S3_ACCESS_KEY_ID=talas
S3_SECRET_ACCESS_KEY=talas-local-secret
S3_FORCE_PATH_STYLE=true

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters

# Session lifetimes in seconds (constitution v2.0.0: access tokens expire
# within 24 hours, refresh tokens within 30 days; refresh must be >= access).
# Defaults shown; access is bounded to 300..86400, refresh to 3600..2592000.
SESSION_ACCESS_TTL_SECONDS=86400
SESSION_REFRESH_TTL_SECONDS=2592000

OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# openai | google | opengo (opengo = OpenCode Go subscription inference;
# requires OPENCODE_API_KEY below; chat-completions model IDs only, e.g.
# glm-5.3, kimi-k2, deepseek-v3)
AI_PROVIDER=openai
AI_DAILY_BUDGET_USD=2.00
AI_FAULT_INJECTION=false

# OpenCode Go (AI_PROVIDER=opengo). Default model glm-5.3-flash: no reasoning
# tokens, so the JSON answer fits the locked 4096-token output cap. Thinking
# models like glm-5.3 spend ~2k+ tokens reasoning from the same cap and will
# truncate the JSON unless their answers are kept very short.
OPENCODE_API_KEY=
AI_MODEL_OPENGO=glm-5.3-flash

RESEND_API_KEY=
EMAIL_FROM=Talas <no-reply@talas.local>
MAILHOG_SMTP_URL=smtp://localhost:1025

LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
WORKER_CONCURRENCY=2
MAX_JOB_MS=120000
